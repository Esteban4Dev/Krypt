{
  "name": "krypt-app",
  "version": "1.0.0",
  "description": "Krypt-app - generador y boveda de contrasenas 100% local, cifrada con AES-GCM",
  "main": "main.js",
  "author": "Krypt-app",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kryptapp.desktop",
    "productName": "Krypt",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": { "target": "dmg", "category": "public.app-category.utilities", "icon": "build/icon.icns" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "build/icon.png" }
  }
}
